{"id": "viva_biogears.composites.circuits.biogears_whole_body_circuits", "name": "biogears_whole_body_circuits", "description": "Every circuit module with setpoints on one real BioGears engine (cardiovascular, respiratory, mechanical ventilator, thermal, supplemental oxygen) plus lymph and tissue fluid, so effects that cross circuits appear in one run. Setpoints start at their baselines; the ventilator and cannula start disconnected, and only one of them can be connected at a time. Optional point, substance and tissue readings.", "parameters": {"state_file": {"type": "string", "default": "StandardMale@0s.xml", "description": "BioGears state in <runtime>/states or the package's states/ (or an absolute path)"}, "patient_file": {"type": "string", "default": "", "description": "Patient file in <runtime>/patients (or a path), stabilized once (about 40 s) and then cached; replaces state_file"}, "conditions": {"type": "map", "default": {}, "description": "Chronic conditions applied while the patient stabilizes, e.g. {ChronicAnemia: {ReductionFactor: 0.3}}; with no patient_file, StandardMale.xml. A different patient, not a perturbation"}, "circuit_additions": {"type": "map", "default": {}, "description": "New path name -> {source, target, resistance_mmHg_s_per_mL}: a resistance path between two FullCardiovascular nodes in different vascular compartments, added with its compartment link so substances follow. A perturbation: the body responds over time"}, "interval": {"type": "float", "default": 1.0, "description": "Seconds per update; 0.02 (BioGears' timestep) resolves per-beat/per-breath waveforms. A non-binary-exact interval can lose the final update of a run to float time accumulation."}, "point_reads": {"type": "boolean", "default": false, "description": "Also read every node and path of the circuit, under circuits/<circuit>_points/"}, "substance_outputs": {"type": "list", "default": [], "description": "Substance quantities to read, each {substance, compartment (omit for whole-body values), property, unit}, e.g. {substance: Oxygen, compartment: Aorta, property: PartialPressure, unit: mmHg}; emitted under circuits/substances/<substance>/<compartment or body>/. Checked against the state when the composite's process is built"}, "tissue_outputs": {"type": "list", "default": [], "description": "Tissue values to read, each {compartment, property, unit}: a tissue's composition (MuscleTissue: MatrixVolume, TotalMass, ...) or its fluid (MuscleTissueExtracellular: Volume, Pressure, WaterVolumeFraction); emitted under circuits/tissues/<compartment>/"}, "hemorrhage_compartment": {"type": "string", "default": "RightLeg", "choices": ["Aorta", "Brain", "Myocardium", "LeftLung", "RightLung", "LeftArm", "RightArm", "Spleen", "SmallIntestine", "LargeIntestine", "Splanchnic", "RightKidney", "LeftKidney", "Liver", "Portal", "LeftLeg", "RightLeg", "VenaCava"], "description": "Hemorrhage site"}, "hemorrhage_rate_mL_per_min": {"type": "float", "default": 0.0, "description": "Initial bleeding rate (BioGears then lowers it with the local pressure); 0 = no bleed"}, "iv_compound": {"type": "string", "default": "Saline", "description": "Infused BioGears compound (e.g. Saline, Blood_ONegative, RingersLactate)"}, "iv_bag_volume_L": {"type": "float", "default": 10.0, "description": "Infusion bag volume"}, "iv_rate_mL_per_min": {"type": "float", "default": 0.0, "description": "Infusion rate from t = 0; 0 = none"}, "intubation_type": {"type": "string", "default": "Tracheal", "choices": ["Tracheal", "Esophageal", "LeftMainstem", "RightMainstem"], "description": "Tube placement used when intubated = 1"}, "intubated": {"type": "float", "default": 0.0, "description": "1 = intubated, 0 = not"}, "ventilator_connection": {"type": "string", "default": "Tube", "choices": ["Tube", "Mask"], "description": "Tube (with intubation) or Mask"}, "connected": {"type": "float", "default": 0.0, "description": "1 = ventilator connected, 0 = off"}, "ventilator_pressure_cmH2O": {"type": "float", "default": 12.0, "description": "Inspiratory pressure the ventilator applies"}, "peep_cmH2O": {"type": "float", "default": 1.0, "description": "Positive end-expiratory pressure"}, "respiration_rate_bpm": {"type": "float", "default": 12.0, "description": "Set breathing rate"}, "inspiratory_expiratory_ratio": {"type": "float", "default": 0.5, "description": "Inspiratory to expiratory time (0.5 = 1:2)"}, "oxygen_fraction": {"type": "float", "default": 0.21, "description": "Oxygen fraction of the delivered gas (wall supply, nitrogen balance)"}, "inlet_flow_L_per_min": {"type": "float", "default": 5.0, "description": "Fresh gas flow into the circuit"}, "ambient_temperature_C": {"type": "float", "default": 22.0, "description": "Air temperature around the body (not the air breathed; see respiration_ambient_temperature_C)"}, "mean_radiant_temperature_C": {"type": "float", "default": 22.0, "description": "Mean radiant temperature of the surroundings"}, "respiration_ambient_temperature_C": {"type": "float", "default": 22.0, "description": "Temperature of the air breathed; drives respiration heat loss"}, "relative_humidity": {"type": "float", "default": 0.6, "description": "Relative humidity in [0, 1]"}, "air_velocity_m_per_s": {"type": "float", "default": 0.1, "description": "Air speed over the body"}, "clothing_resistance_clo": {"type": "float", "default": 0.5, "description": "Clothing thermal resistance (1 clo = 0.155 m^2 K/W)"}, "active_heating_W": {"type": "float", "default": 0.0, "description": "Active heating power; BioGears delivers power x area fraction"}, "active_heating_area_fraction": {"type": "float", "default": 1.0, "description": "Fraction of skin area under active heating, in (0, 1]"}, "active_cooling_W": {"type": "float", "default": 0.0, "description": "Active cooling power; BioGears removes power x area fraction"}, "active_cooling_area_fraction": {"type": "float", "default": 1.0, "description": "Fraction of skin area under active cooling, in (0, 1]"}, "applied_temperature_on": {"type": "float", "default": 0.0, "description": "1 = apply applied_temperature_C over the clothing, 0 = off"}, "applied_temperature_C": {"type": "float", "default": 22.0, "description": "Applied temperature, used when applied_temperature_on = 1"}, "applied_temperature_area_fraction": {"type": "float", "default": 1.0, "description": "Fraction in (0, 1] by which BioGears blends the applied temperature with the ambient temperature"}, "oxygen_connected": {"type": "float", "default": 0.0, "description": "1 = cannula on, 0 = off"}, "oxygen_flow_L_per_min": {"type": "float", "default": 4.0, "description": "Nasal cannula oxygen flow"}}, "state": {"biogears": {"_type": "process", "address": "local:BioGearsCircuitProcess", "config": {"modules": ["cardiovascular", "respiratory", "mechanical_ventilator", "thermal", "supplemental_oxygen", "lymph", "tissue_fluid"], "state_file": "StandardMale@0s.xml", "patient_file": "", "conditions": {}, "circuit_additions": {}, "hemorrhage_compartment": "RightLeg", "iv_compound": "Saline", "iv_bag_volume_L": 10.0, "intubation_type": "Tracheal", "ventilator_connection": "Tube"}, "interval": 1.0, "inputs": {"setpoints": ["interventions"]}, "outputs": {"cardiovascular": ["circuits", "cardiovascular"], "respiratory": ["circuits", "respiratory"], "mechanical_ventilator": ["circuits", "mechanical_ventilator"], "thermal": ["circuits", "thermal"], "supplemental_oxygen": ["circuits", "supplemental_oxygen"], "lymph": ["circuits", "lymph"], "tissue_fluid": ["circuits", "tissue_fluid"], "irreversible_state": ["circuits", "irreversible_state"]}, "doc": "Bridge to one real BioGears 8.2.0 engine, exposing the selected circuit modules.\n\n``config.modules`` names entries of ``viva_biogears.circuits.MODULES``. Each module\ncontributes a port subtree named after it:\n\n- outputs: the module's BioGears data requests as ``overwrite[float]`` ports at the\n  module's nested paths (e.g. ``cardiovascular/central/aorta/pressure_mmHg``);\n- inputs, under the single ``setpoints`` port: the module's setpoints as\n  ``overwrite[float]`` ports whose schema default is the baseline value, sent to\n  BioGears as actions only on change (e.g. ``setpoints/cardiovascular/hemorrhage_rate_mL_per_min``).\n\nInputs and outputs use disjoint top-level port names on purpose: process-bigraph\nprojects ``initial_state()`` through the input wires as well as the output wires,\nso a shared name would copy readings into the setpoint store.\n\nOutputs follow ``BioGearsProcess``'s contract: ``initial_state()`` seeds each store\nwith the loaded state's reading and every update emits BioGears' current reading.\n``irreversible_state`` turns True once BioGears reports its irreversible state; the\nengine is not advanced after that. Identical requests from different modules share\none BioGears request. A request BioGears does not connect raises at load; a NaN\nreading raises, naming the request, unless the request allows it.\n\nAll changed setpoint groups are validated before any action is sent, and so is the\nairway rule: at most one module's ``airway_device`` connected, and none connecting\nin the update in which another disconnects (BioGears would process the new device\nbefore the old one's removal and fail every step).\n\nThe engine loads ``state_file`` (a name in ``<runtime>/states`` or the package's\n``states/``, or an absolute path), or ``patient_file``/``conditions`` stabilized and\ncached (``viva_biogears.patients``). A state saved mid-run carries its actions; each\nsetpoint group starts at the state's values (``ActionBinding.loaded``), so a branch\nwith the same setpoints continues the run exactly and one that differs sends the\nchange. A state whose airway is held by a device the process doesn't control is\nrefused when the process can connect one. ``save_state_times_s`` saves the engine\nat those times (``viva_biogears.states``).", "interval_label": "1 s", "_contract": {"summary": "type(object) -> the object's type", "description": "type(name, bases, dict, **kwds) -> a new type", "inputs": {}, "outputs": {}, "config": {}, "math": [], "symbols": {}, "assumptions": [], "references": [], "face": {"inputs": {}, "outputs": {}}, "amendments": []}, "_inputs": {"setpoints": {"cardiovascular": {"hemorrhage_rate_mL_per_min": {"_type": "overwrite[float]", "_default": 0.0}, "iv_rate_mL_per_min": {"_type": "overwrite[float]", "_default": 0.0}}, "respiratory": {"intubated": {"_type": "overwrite[float]", "_default": 0.0}}, "mechanical_ventilator": {"connected": {"_type": "overwrite[float]", "_default": 0.0}, "ventilator_pressure_cmH2O": {"_type": "overwrite[float]", "_default": 12.0}, "peep_cmH2O": {"_type": "overwrite[float]", "_default": 1.0}, "respiration_rate_bpm": {"_type": "overwrite[float]", "_default": 12.0}, "inspiratory_expiratory_ratio": {"_type": "overwrite[float]", "_default": 0.5}, "oxygen_fraction": {"_type": "overwrite[float]", "_default": 0.21}, "inlet_flow_L_per_min": {"_type": "overwrite[float]", "_default": 5.0}}, "thermal": {"ambient_temperature_C": {"_type": "overwrite[float]", "_default": 22.0}, "mean_radiant_temperature_C": {"_type": "overwrite[float]", "_default": 22.0}, "respiration_ambient_temperature_C": {"_type": "overwrite[float]", "_default": 22.0}, "relative_humidity": {"_type": "overwrite[float]", "_default": 0.6}, "air_velocity_m_per_s": {"_type": "overwrite[float]", "_default": 0.1}, "clothing_resistance_clo": {"_type": "overwrite[float]", "_default": 0.5}, "active_heating_W": {"_type": "overwrite[float]", "_default": 0.0}, "active_heating_area_fraction": {"_type": "overwrite[float]", "_default": 1.0}, "active_cooling_W": {"_type": "overwrite[float]", "_default": 0.0}, "active_cooling_area_fraction": {"_type": "overwrite[float]", "_default": 1.0}, "applied_temperature_on": {"_type": "overwrite[float]", "_default": 0.0}, "applied_temperature_C": {"_type": "overwrite[float]", "_default": 22.0}, "applied_temperature_area_fraction": {"_type": "overwrite[float]", "_default": 1.0}}, "supplemental_oxygen": {"oxygen_connected": {"_type": "overwrite[float]", "_default": 0.0}, "oxygen_flow_L_per_min": {"_type": "overwrite[float]", "_default": 4.0}}}}, "_outputs": {"cardiovascular": {"hemodynamics": {"heart_rate_bpm": "overwrite[float]", "mean_arterial_pressure_mmHg": "overwrite[float]", "systolic_pressure_mmHg": "overwrite[float]", "diastolic_pressure_mmHg": "overwrite[float]", "arterial_pressure_mmHg": "overwrite[float]", "pulse_pressure_mmHg": "overwrite[float]", "cardiac_output_L_per_min": "overwrite[float]", "cardiac_index_L_per_min_m2": "overwrite[float]", "stroke_volume_mL": "overwrite[float]", "ejection_fraction": "overwrite[float]", "central_venous_pressure_mmHg": "overwrite[float]", "mean_central_venous_pressure_mmHg": "overwrite[float]", "pulmonary_arterial_pressure_mmHg": "overwrite[float]", "pulmonary_mean_arterial_pressure_mmHg": "overwrite[float]", "pulmonary_capillary_wedge_pressure_mmHg": "overwrite[float]", "systemic_vascular_resistance_mmHg_min_per_L": "overwrite[float]", "pulmonary_vascular_resistance_mmHg_min_per_L": "overwrite[float]", "blood_volume_mL": "overwrite[float]", "cerebral_blood_flow_mL_per_min": "overwrite[float]", "cerebral_perfusion_pressure_mmHg": "overwrite[float]", "intracranial_pressure_mmHg": "overwrite[float]", "mean_skin_flow_mL_per_min": "overwrite[float]", "total_blood_volume_lost_mL": "overwrite[float]"}, "central": {"aorta": {"pressure_mmHg": "overwrite[float]", "volume_mL": "overwrite[float]", "inflow_mL_per_min": "overwrite[float]", "outflow_mL_per_min": "overwrite[float]"}, "heart": {"pressure_mmHg": "overwrite[float]", "volume_mL": "overwrite[float]", "inflow_mL_per_min": "overwrite[float]", "outflow_mL_per_min": "overwrite[float]"}, "left_heart": {"pressure_mmHg": "overwrite[float]", "volume_mL": "overwrite[float]", "inflow_mL_per_min": "overwrite[float]", "outflow_mL_per_min": "overwrite[float]"}, "right_heart": {"pressure_mmHg": "overwrite[float]", "volume_mL": "overwrite[float]"